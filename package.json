{
  "name": "croak",
  "version": "0.0.0",
  "private": true,
  "description": "Croak before you install: a pre-execution gate for package installs, built for AI agents",
  "type": "module",
  "bin": {
    "croak": "./dist/cli.js",
    "croak-install": "./scripts/croak-install.sh",
    "croak-hook": "scripts/croak-hook.sh"
  },
  "files": [
    "dist",
    "scripts/croak-install.sh",
    "scripts/croak-hook.sh"
  ],
  "engines": {
    "node": ">=24.2.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm invariants && pnpm test",
    "eval": "node src/eval/main.ts",
    "invariants": "node src/tools/check-invariants.ts",
    "croak": "node src/cli.ts",
    "redos": "node src/tools/redos-check.ts",
    "corpus:fetch": "sh scripts/corpus-fetch.sh",
    "corpus": "node src/tools/corpus.ts",
    "corpus:packages": "node src/tools/package-corpus.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
